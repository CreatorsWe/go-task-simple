{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task configure profile",
  "description": "a configure profile of task tool",
  "type": "object",
  "properties": {
    "vars": {
      "type": "object",
      "description": "declare variable used to task commands",
      "additionalProperties": {
        "anyOf": [
          {"type": "string"},
          {"type": "integer"},
          {
            "type": "array",
            "items": {
              "anyOf": [
                {"type": "string"},
                {"type": "integer"}
              ]
            }
          }
        ]
      }
    },
    "tasks": {
      "type": "object",
      "description": "define task",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "desc": {
            "anyOf": [
              {"type": "string"},
              {"type": "null"}
            ]
          },
          "cmds": {
            "type": "array",
            "items": {
              "anyOf": [
                {"type": "string"},
                {"type": "null"}
              ]
            }
          },
          "timeout": {
            "type": "integer",
            "minimum": 0
          },
          "silent": {
            "type": "boolean"
          },
          "parallel": {
            "type": "boolean"
          }
        },
        "required": ["cmds"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "required": ["tasks"]
}